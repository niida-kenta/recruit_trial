---
import { phoneNumber, siteName } from '@root/project.config';
import { Image } from 'astro:assets';

import aloPc from '@/images/alo-pc.svg';
import aloSp from '@/images/alo-sp.svg';
import chevronUp from '@/images/chevron-up.svg';
import graphPc from '@/images/graph-pc.svg';
import graphSp from '@/images/graph-sp.svg';
import interiorPc from '@/images/interior-pc.jpg';
import interiorSp from '@/images/interior-sp.jpg';
import kvPc from '@/images/kv-pc.jpg';
import kvSp from '@/images/kv-sp.jpg';
import mailIconSpHeader from '@/images/mail-icon-sp-header.svg';
import phoneIconSpFooter from '@/images/phone-icon-sp-footer.svg';
import phoneIconSpHeader from '@/images/phone-icon-sp-header.svg';
import product1Pc from '@/images/product-1-pc.jpg';
import product1Sp from '@/images/product-1-sp.jpg';
import product2Pc from '@/images/product-2-pc.jpg';
import product2Sp from '@/images/product-2-sp.jpg';
import product3Pc from '@/images/product-3-pc.jpg';
import product3Sp from '@/images/product-3-sp.jpg';
import product4Pc from '@/images/product-4-pc.jpg';
import product4Sp from '@/images/product-4-sp.jpg';
import stuckPc from '@/images/stuck-pc.svg';
import stuckSp from '@/images/stuck-sp.svg';
import Layout from '@/layouts/Basic/Basic.astro';
import '@/styles/page.css';
---

<Layout>
  <header>
    <h1>{siteName}</h1>
    <div class="header-actions">
      <div class="pc-only-wrapper">
        <div>
          <div class="tel">
            <span class="tel-text">TEL</span>
            <address class="phone-number">{phoneNumber}</address>
          </div>
          <p class="business-hours">
            <time datetime="10:00">10:00</time>
            ～
            <time datetime="18:00">18:00</time>
            土日・祝日・年末年始除く
          </p>
        </div>
        <button class="inquiry">お問い合わせ</button>
      </div>
      <div class="sp-only-wrapper">
        <Image
          alt="phone icon"
          src={phoneIconSpHeader}
        />
        <Image
          alt="mail icon"
          src={mailIconSpHeader}
        />
      </div>
      <button class="menu">
        <span class="menu-text">MENU</span>
        <span
          aria-hidden="true"
          class="menu-lines"
        >
          <span class="line"></span>
          <span class="line"></span>
        </span>
      </button>
    </div>
  </header>

  <main>
    <section id="hero">
      <Image
        alt="mobile hero image"
        class="hero-image sp-only"
        sizes="100vw"
        src={kvSp}
        widths={[375, 750]}
      />
