---
import type { HTMLAttributes } from 'astro/types';

import { siteName } from '@root/project.config';
import { Font } from 'astro:assets';

import { IMG_DIR } from '@/constants/config';
import '@/styles/global.css';

type ComponentHTMLAttributes = HTMLAttributes<'html'>;

type Props = ComponentHTMLAttributes & {};

const { ...attrs } = Astro.props;
---

<html
  lang="ja"
  {...attrs as ComponentHTMLAttributes}
>
  <head>
    <meta charset="utf-8" />

    <meta
      content="width=device-width, initial-scale=1.0"
      name="viewport"
    />

    <link
      href={`${IMG_DIR}/common/favicon.svg`}
      rel="icon"
      type="image/svg+xml"
    />

    <title>{siteName}</title>

    <!-- markuplint-disable-next-line permitted-contents -->
    <Font cssVariable="--font-noto-sans-jp" />
    <!-- markuplint-disable-next-line permitted-contents -->
    <Font cssVariable="--font-inter" />
    <!-- markuplint-disable-next-line permitted-contents -->
    <Font cssVariable="--font-lato" />
  </head>
  <body>
    <slot />

    <script>
      import './script';
    </script>
  </body>
</html>
