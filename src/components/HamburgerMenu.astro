---
import { phoneNumber, siteName } from '@root/project.config';
import { Image } from 'astro:assets';

import phoneIconSpFooter from '@/images/phone-icon-sp-footer.svg';
---

<dialog class="hamburger-menu">
  <p>{siteName}</p>
  <nav>
    <ul>
      <li><a href="#about">ALOについて</a></li>
      <li><a href="#">ALOの強み</a></li>
      <li><a href="#product">ALOの商品紹介</a></li>
      <li><a href="#">ご加盟までの流れ</a></li>
      <li><a href="#">よくあるご質問</a></li>
    </ul>
  </nav>
  <div>
    <Image
      alt="phone icon"
      class="sp-only"
      src={phoneIconSpFooter}
    />
    <p>メールでのお問い合わせ</p>
    <button>お問い合わせ</button>
  </div>
  <div>
    <p>お電話でのお問い合わせ</p>
    <div class="tel">
      <Image
        alt="phone icon"
        class="sp-only"
        src={phoneIconSpFooter}
      />
      <div>
        <address class="phone-number">{phoneNumber}</address>
        <p class="business-hours">
          <time datetime="10:00">10:00</time>
          ～
          <time datetime="18:00">18:00</time>
          土日・祝日・年末年始除く
        </p>
      </div>
    </div>
  </div>
</dialog>
