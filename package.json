{
  "name": "lw-recruit-trial",
  "type": "module",
  "version": "2.0.0",
  "description": "リネアワークス中途採用コーディングテスト",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lineaworks/recruit_trial.git"
  },
  "author": "Lineaworks inc.",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lineaworks/recruit_trial/issues"
  },
  "homepage": "https://github.com/lineaworks/recruit_trial#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "astro": "astro",
    "prepare": "husky",
    "lint-html:astro": "markuplint --fix --allow-warnings 'src/**/*.astro'",
    "lint-html": "run-s lint-html:*",
    "lint-script:config": "eslint './*.{js,cjs,mjs,ts,md}' --fix --ignore-pattern '!.*rc.cjs' --ignore-pattern '!*.config.{js,cjs,mjs,ts}' --no-error-on-unmatched-pattern",
    "lint-script:task": "eslint './script/node/*.{js,cjs,mjs,ts}' --fix --no-error-on-unmatched-pattern",
    "lint-script:src": "eslint './src/**/*.{js,jsx,cjs,mjs,ts,tsx,astro,css,md}' --fix --no-error-on-unmatched-pattern",
    "lint-script": "run-s lint-script:*",
    "prettier:config": "prettier --write --no-error-on-unmatched-pattern './*.{js,cjs,mjs,ts}'",
    "prettier:task": "prettier --write --no-error-on-unmatched-pattern './script/node/*.ts'",
    "prettier:src": "prettier --write --no-error-on-unmatched-pattern './src/**/*.{js,jsx,cjs,mjs,ts,tsx,astro,css}'",
    "prettier": "run-s prettier:*",
    "format": "run-s lint-html lint-script prettier",
    "check:typescript": "tsc --noEmit",
    "check:astro": "astro check",
    "check": "run-s check:*",
    "lint-staged": "lint-staged",
    "cleanup": "tsx ./script/node/cleanup.ts",
    "cleanup:dist": "npm run cleanup",
    "cleanup:assets": "rimraf .tmp",
    "compile:statics": "tsx ./script/node/statics.ts",
    "compile:images": "tsx ./script/node/images.ts",
    "compile:icon-font": "tsx ./script/node/icon-font.ts",
    "compile:svg-sprite": "tsx ./script/node/svg-sprite.ts",
    "compile": "run-s compile:*",
    "watch:statics": "onchange './src/statics/**/*' -- tsx ./script/node/statics.ts '{{changed}}'",
    "watch:images": "onchange './src/images/**/*.{jpg,jpeg,png,gif,svg}' -- tsx ./script/node/images.ts '{{changed}}'",
    "watch:icon-font": "onchange './src/icon-font/svg/*.svg' -- tsx ./script/node/icon-font.ts '{{changed}}'",
    "watch:svg-sprite": "onchange './src/svg-sprite/*.svg' -- tsx ./script/node/svg-sprite.ts '{{changed}}'",
    "watch": "run-p watch:*",
    "dev:assets": "run-p watch:*",
    "dev:astro": "astro dev --host",
    "dev": "git lfs pull && run-s cleanup:assets compile:* && BUILD_BY=astro run-p dev:*",
    "build:assets": "run-s compile:*",
    "build:vite": "vite build",
    "build:astro": "astro build",
    "build": "git lfs pull && run-s cleanup:assets cleanup:dist && cross-env NODE_ENV=production run-s build:assets build:astro cleanup:assets",
    "preview:astro": "astro preview",
    "preview": "run-s build preview:*"
  },
  "overrides": {
    "tar": "^7.5.19",
    "node-gyp": "^13.0.0"
  },
  "dependencies": {
    "astro": "^7.0.3",
    "stats-js": "^1.0.1",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.2",
    "@markuplint/astro-parser": "^4.18.4",
    "@tailwindcss/vite": "^4.3.2",
    "@types/fancy-log": "^2.0.2",
    "@types/node": "^26.0.1",
    "@types/svg-sprite": "^0.0.39",
    "@types/vusion__webfonts-generator": "^0.8.6",
    "@typescript-eslint/parser": "^8.62.1",
    "@vusion/webfonts-generator": "^0.8.0",
    "chalk": "^5.6.2",
    "cross-env": "^10.1.0",
    "del": "^8.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-tailwindcss": "^4.0.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fancy-log": "^2.0.0",
    "filesize": "^11.0.19",
    "globals": "^17.7.0",
    "globby": "^16.2.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.8",
    "markuplint": "^4.18.3",
    "npm-run-all2": "^9.0.2",
    "onchange": "^7.1.0",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.2",
    "svg-sprite": "^2.0.4",
    "svgo": "^4.0.1",
    "tailwind-csstree": "^0.3.3",
    "terser": "^5.48.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.0"
  }
}
